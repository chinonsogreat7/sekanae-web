# API server
NODE_ENV=production
API_PUBLIC_URL=https://sekanae-api.onrender.com
WEB_ORIGIN=https://sekanae.co
DATABASE_URL=

# Admin
ADMIN_API_KEY=
ADMIN_EMAIL=
ADMIN_LOGIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Email
RESEND_API_KEY=
EMAIL_FROM=Sekanae <orders@sekanae.co>

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=https://sekanae.co/checkout/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=https://sekanae.co/cart

# Cloudinary media uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=sekanae/products

# Commerce defaults
DEFAULT_CURRENCY=EUR
DEFAULT_MARKET_COUNTRY=MT
DEFAULT_SHIPPING_AMOUNT=0
VAT_RATE=0.18
VAT_INCLUDED=true

# Frontend static site
VITE_API_URL=https://sekanae-api.onrender.com
